PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# mssql = connect to your SQL Server (default)
# memory = run with built-in demo data, no DB required
DB_DRIVER=mssql

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=CruiseDB
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_ENCRYPT=false          # true for Azure SQL
DB_TRUST_CERT=true        # false for Azure SQL

# Secret key required in the x-admin-key header for /api/admin/* routes.
# Leave empty to disable the check (dev only).
ADMIN_KEY=admin123
